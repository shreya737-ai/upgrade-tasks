@model week7_task1.Models.ContactInfo

@{
    ViewData["Title"] = "Contact Details";
}

<h2>Contact Details</h2>

@if (Model != null)
{
    <table class="table table-bordered">
        <tr>
            <th>Contact ID</th>
            <td>@Model.ContactId</td>
        </tr>
        <tr>
            <th>First Name</th>
            <td>@Model.FirstName</td>
        </tr>
        <tr>
            <th>Last Name</th>
            <td>@Model.LastName</td>
        </tr>
        <tr>
            <th>Company Name</th>
            <td>@Model.CompanyName</td>
        </tr>
        <tr>
            <th>Email ID</th>
            <td>@Model.EmailId</td>
        </tr>
        <tr>
            <th>Mobile No</th>
            <td>@Model.MobileNo</td>
        </tr>
        <tr>
            <th>Designation</th>
            <td>@Model.Designation</td>
        </tr>
    </table>
}
else
{
    <div class="alert alert-danger">
        Contact not found.
    </div>
}

<p>
    <a asp-controller="ContactInfo" asp-action="ShowContacts" class="btn btn-secondary">Back to List</a>
</p>