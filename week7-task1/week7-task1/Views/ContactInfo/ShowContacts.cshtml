@model List<week7_task1.Models.ContactInfo>

@{
    ViewData["Title"] = "Show Contacts";
}

<h2>All Contacts</h2>

<p>
    <a asp-controller="ContactInfo" asp-action="AddContact" class="btn btn-primary">Add New Contact</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Contact ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Company Name</th>
            <th>Email ID</th>
            <th>Mobile No</th>
            <th>Designation</th>
            <th>Search</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var contact in Model)
            {
                <tr>
                    <td>@contact.ContactId</td>
                    <td>@contact.FirstName</td>
                    <td>@contact.LastName</td>
                    <td>@contact.CompanyName</td>
                    <td>@contact.EmailId</td>
                    <td>@contact.MobileNo</td>
                    <td>@contact.Designation</td>
                    <td>
                        <a asp-controller="ContactInfo"
                               asp-action="GetContactById"
                               asp-route-id="@contact.ContactId"
                               class="btn btn-info btn-sm">
                            View
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8">No contacts available.</td>
            </tr>
        }
    </tbody>
</table>
