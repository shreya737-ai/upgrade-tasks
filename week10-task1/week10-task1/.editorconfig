
# All files
[*]
indent_style = space

# Xml files
[*.xml]
indent_size = 2

# C# files
[*.cs]

# 🔹 Naming conventions
dotnet_naming_style.pascal_case.capitalization = pascal_case

# 🔹 Enforce PascalCase for methods
dotnet_naming_rule.methods_should_be_pascal_case.symbols = methods
dotnet_naming_rule.methods_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.methods_should_be_pascal_case.severity = warning

# 🔹 Null reference warnings
dotnet_diagnostic.CS8602.severity = warning

# 🔹 Unused variables
dotnet_diagnostic.CS0168.severity = warning

# 🔹 Avoid long/complex methods
dotnet_code_quality.CA1502.max_complexity = 10

# 🔹 Prefer meaningful code
dotnet_diagnostic.IDE0051.severity = warning

# 🔹 General analyzer severity
dotnet_analyzer_diagnostic.severity = warning
