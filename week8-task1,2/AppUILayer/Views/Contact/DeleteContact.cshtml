@model DAL.Models.ContactInfo
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Delete Contact";
}

<h2>Delete Contact</h2>

<h4>Are you sure you want to delete this contact?</h4>

<table class="table table-bordered">
    <tr><th>Contact Id</th><td>@Model.ContactId</td></tr>
    <tr><th>First Name</th><td>@Model.FirstName</td></tr>
    <tr><th>Last Name</th><td>@Model.LastName</td></tr>
    <tr><th>Email</th><td>@Model.EmailId</td></tr>
</table>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.ContactId" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="ShowContacts" class="btn btn-secondary">Cancel</a>
</form>