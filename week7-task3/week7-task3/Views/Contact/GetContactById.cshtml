@model week7_task3.Models.ContactInfo

@{
    ViewData["Title"] = "Contact Details";
}

<h2>Contact Details</h2>

@if (Model != null)
{
    <table border="1" cellpadding="10">
        <tr>
            <th>Contact ID</th>
            <td>@Model.ContactId</td>
        </tr>
        <tr>
            <th>First Name</th>
            <td>@Model.FirstName</td>
        </tr>
        <tr>
            <th>Last Name</th>
            <td>@Model.LastName</td>
        </tr>
        <tr>
            <th>Company Name</th>
            <td>@Model.CompanyName</td>
        </tr>
        <tr>
            <th>Email ID</th>
            <td>@Model.EmailId</td>
        </tr>
        <tr>
            <th>Mobile No</th>
            <td>@Model.MobileNo</td>
        </tr>
        <tr>
            <th>Designation</th>
            <td>@Model.Designation</td>
        </tr>
    </table>
}
else
{
    <p style="color:red;">Contact not found!</p>
}

<br />
<a href="/Contact/ShowContacts">Back to Contact List</a>